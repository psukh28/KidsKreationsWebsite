---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import TrustedRegions from "../components/TrustedRegions.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import FeaturesSection from "../components/sections/FeaturesSection.astro";
import FeaturedProductsSection from "../components/sections/FeaturedProductsSection.astro";
import CTASection from "../components/sections/CTASection.astro";

// Import assets
import romper from "../assets/products/romper.webp";
import giftset from "../assets/products/giftset.webp";
import twopiece from "../assets/products/2piece.jpg";
import herobaby from "../assets/home/herobaby5.png";
import organiclogo from "../assets/icons/organic.svg";
import palette from "../assets/icons/paintbrush.svg";
import globe from "../assets/icons/international.svg";

// Import styles
import "../styles/base/variables.css";
import "../styles/base/typography.css";
import "../styles/ui/cards.css";
import "../styles/utils/animations.css";
import "../styles/pages/home.css";
import "../styles/components/hero.css";
import "../styles/components/features.css";
import "../styles/components/products.css";
import "../styles/components/cta.css";
import "../styles/components/buttons.css";
import "../styles/components/trusted-regions-mobile.css";
import "../styles/utils/responsive.css";

const features: Array<{
	title: string;
	description: string;
	icon: ImageMetadata | string;
	type: "image" | "fa";
	color: string;
}> = [
	{
		title: "Certified Organic Fabrics",
		description:
			"Certified materials ensuring the highest quality and safety standards for infantwear.",
		icon: organiclogo,
		type: "image" as const,
		color: "var(--success)",
	},
	{
		title: "Made to Fit Your Brand",
		description:
			"Custom designs, packaging, and branding solutions tailored to your vision.",
		icon: palette,
		type: "image" as const,
		color: "var(--primary)",
	},
	{
		title: "Internationally Compliant",
		description:
			"Export-ready products meeting global safety and quality standards.",
		icon: globe,
		type: "image" as const,
		color: "var(--primary)",
	},
];

const featuredProducts = [
	{
		title: "Gift Sets",
		description:
			"Beautifully curated babywear sets for gifting, complete with coordinated outfits and accessories.",
		image: giftset,
		badge: "Popular",
		url: "/products/gift-sets",
	},
	{
		title: "Rompers & Playsuits",
		description:
			"One-piece outfits made for play, comfort, and easy dressing. Simple, stylish and lovable.",
		image: romper,
		badge: "Best Seller",
		url: "/products/rompers-playsuits",
	},
	{
		title: "Two-Piece Sets",
		description:
			"Versatile top-and-bottom sets for daily wear or dress-up moments.",
		image: twopiece,
		badge: "New",
		url: "/products/two-piece-sets",
	},
];
---

<Layout title="Kids Kreations - Premium Infantwear Manufacturing">
	<Navigation />

	<main>
		<HeroSection
			heroImage={herobaby}
			title="Your Global Partner in Premium Babywear Manufacturing"
			subtitle="TRUSTED BY GLOBAL BRANDS"
			description="Large-scale OEM manufacturing for global brands and retailers."
			features={[
				"Certified organic & sustainable production",
				"In-house design, development & sampling", 
				"Seamless global logistics and compliance"
			]}
			note="Chosen by international partners across Europe, the UK, the US, and Asia. Built for quality. Engineered for scale."
		/>

		<div class="section-connector"></div>
		<FeaturedProductsSection products={featuredProducts} />

		<TrustedRegions />

		<FeaturesSection features={features} />

		<CTASection
			title="Let's create something beautiful together."
			description="Start your journey with Kids Kreations today"
			buttonText="Request a Quote"
			buttonUrl="/contact"
		/>
	</main>

	<Footer />
</Layout>

<script>
	// Initialize AOS (Animate On Scroll)
	document.addEventListener("DOMContentLoaded", () => {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add("visible");
					}
				});
			},
			{
				threshold: 0.1,
			},
		);

		document.querySelectorAll("[data-aos]").forEach((element) => {
			observer.observe(element);
		});
	});
</script>
