---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import TrustedRegions from "../components/TrustedRegions.astro";
import { Image } from "astro:assets";
import romper from "../assets/products/romper.webp";
import giftset from "../assets/products/giftset.webp";
import twopiece from "../assets/products/2piece.jpg";
import herobaby from "../assets/home/herobaby5.png";
import organiclogo from "../assets/icons/organic.svg";
import palette from "../assets/icons/paintbrush.svg";
import globe from "../assets/icons/international.svg";

const features = [
	{
		title: "Certified Organic Fabrics",
		description:
			"Certified materials ensuring the highest quality and safety standards for infantwear.",
		icon: organiclogo,
		type: "image",
		color: "var(--success)",
	},
	{
		title: "Made to Fit Your Brand",
		description:
			"Custom designs, packaging, and branding solutions tailored to your vision.",
		icon: palette,
		type: "image",
		color: "var(--primary)",
	},
	{
		title: "Internationally Compliant",
		description:
			"Export-ready products meeting global safety and quality standards.",
		icon: globe,
		type: "image",
		color: "var(--primary)",
	},
];

const featuredProducts = [
	{
		title: "Gift Sets",
		description:
			"Beautifully curated babywear sets for gifting, complete with coordinated outfits and accessories.",
		image: giftset,
		format: "jpeg",
		badge: "Popular",
		url: "/products/gift-sets",
	},
	{
		title: "Rompers & Playsuits",
		description:
			"One-piece outfits made for play, comfort, and easy dressing. Simple, stylish and lovable.",
		image: romper,
		badge: "Best Seller",
		url: "/products/rompers-playsuits",
	},
	{
		title: "Two-Piece Sets",
		description:
			"Versatile top-and-bottom sets for daily wear or dress-up moments.",
		image: twopiece,
		badge: "New",
		url: "/products/two-piece-sets",
	},
];
---

<Layout title="Kids Kreations - Premium Infantwear Manufacturing">
	<Navigation />

	{/* Font links are now handled in the Layout component */}

	<main>
		<section class="hero-section">
			<div class="hero-content">
				<div class="cotton-frame">
					<div class="hero-text text-center max-w-md mx-auto">
						<div class="hero-tagline">YOUR TRUSTED OEM PARTNER</div>
						<h1 class="hero-heading leading-tight">
							Premium Babywear <br class="mobile-hide" /> Manufacturing
						</h1>
						<p class="hero-subtext">
							Large-scale OEM manufacturing trusted by industry
							leaders, combining certified organic production,
							advanced design capabilities, and seamless global
							logistics.
						</p>
						<p class="hero-note">
							Chosen by global brands and retailers. Built for
							excellence, engineered for scale
						</p>
						<div class="hero-cta">
							<a
								class="btn-primary text-sm font-semibold"
								href="/products">Explore Products →</a
							>
							<a
								class="btn-outline text-sm font-semibold"
								href="https://calendar.app.google/Zi9Mo7C2ggxqiDym6"
								target="_blank"
								rel="noopener noreferrer">Schedule a Meeting</a
							>
						</div>
					</div>
				</div>
				<div class="hero-image-wrapper max-w-md mx-auto mt-6">
					<Image
						src={herobaby}
						alt="Happy baby in premium infantwear"
						width={2200}
						height={2200}
						loading="eager"
						class="hero-img"
					/>
				</div>
			</div>
		</section>
		<div class="section-connector"></div>
		<TrustedRegions />

		<section class="features">
			<div class="container">
				<div class="section-header">
					<h2>Why Choose Us</h2>
					<p>
						Premium manufacturing solutions for your infantwear
						brand
					</p>
				</div>
				<div class="features-grid">
					{
						features.map((feature) => (
							<div class="feature-card" data-aos="fade-up">
								<div
									class="feature-icon"
									style={`--icon-color: ${feature.color}`}
								>
									{feature.type === "fa" ? (
										<i class={`fas ${feature.icon}`} />
									) : (
										<Image
											src={feature.icon}
											alt={feature.title}
											width={64}
											height={64}
											quality={100}
											loading="lazy"
											class="feature-icon-img"
										/>
									)}
								</div>
								<h3>{feature.title}</h3>
								<p>{feature.description}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section class="featured-products">
			<div class="container">
				<div class="section-header">
					<h2>Featured Products</h2>
					<p>Explore our premium infantwear collection</p>
				</div>
				<div class="products-grid">
					{
						featuredProducts.map((product) => (
							<div class="product-card" data-aos="fade-up">
								<div class="product-image">
									<Image
										src={product.image}
										alt={product.title}
										width={600}
										height={600}
										quality={80}
										format="webp"
										loading="lazy"
										fetchpriority="auto"
										class="product-img"
									/>
									<span class="product-badge">
										{product.badge}
									</span>
								</div>
								<div class="product-info">
									<h3>{product.title}</h3>
									<p>{product.description}</p>
									<a
										href={product.url}
										class="button button-text"
									>
										View Collection
									</a>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section class="cta">
			<div class="container">
				<div class="cta-content">
					<h2>Let's create something beautiful together.</h2>
					<p>Start your journey with Kids Kreations today</p>
					<a href="/contact" class="button button-primary"
						>Request a Quote</a
					>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<style>
	/* Typography */
	h1 {
		font-family: "Libre Baskerville", serif;
		font-size: clamp(1.75rem, 4.5vw, 2.75rem);
		line-height: 1.15;
		color: var(--text-dark);
		margin-bottom: var(--spacing-md);
	}

	h2 {
		font-family: "Libre Baskerville", serif;
		font-size: clamp(1.75rem, 4vw, 2.3rem);
		line-height: 1.3;
		color: var(--text-dark);
		margin-bottom: var(--spacing-sm);
	}

	h3 {
		font-family: "Inter", serif;
		font-size: clamp(1.25rem, 3vw, 1.75rem);
		line-height: 1.4;
		color: var(--text-dark);
		margin-bottom: var(--spacing-sm);
	}

	p {
		font-family: "Inter", sans-serif;
		font-size: clamp(1rem, 2vw, 1.25rem);
		line-height: 1.6;
		color: var(--text-light);
	}

	/* Hero Typography */
	.hero-tagline {
		font-family: "Inter", sans-serif;
		font-size: 0.9rem;
		letter-spacing: 0.2em;
		color: #64748b;
		text-transform: uppercase;
		font-weight: 600;
		margin-bottom: 0.5rem;
		position: relative;
	}

	.hero-tagline::after {
		content: "";
		position: absolute;
		bottom: -4px;
		left: 50%;
		transform: translateX(-50%);
		width: 40px;
		height: 2px;
		background: linear-gradient(90deg, #94a3b8, #cbd5e1);
		border-radius: 1px;
	}

	.hero-heading {
		font-family: "Libre Baskerville", serif;
		font-size: clamp(1.75rem, 4.5vw, 2.75rem);
		line-height: 1.4 !important;
		font-weight: 600;
		color: #1e293b;
		margin-bottom: 1rem;
		background: linear-gradient(135deg, #1e293b 0%, #475569 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-description {
		font-family: "Inter", sans-serif;
		font-size: 1rem;
		line-height: 1.7;
		color: #334155;
		margin-bottom: 1rem;
	}

	.hero-subnote {
		font-family: "Inter", sans-serif;
		font-size: 0.85rem;
		font-style: italic;
		color: #64748b;
		margin-bottom: 1.5rem;
	}

	/* Unified background with seamless flow */
	main {
		position: relative;
		background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
		overflow: hidden;
	}

	/* Single subtle pattern for entire page */
	main::before {
		content: "";
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23cbd5e1' fill-opacity='0.1'%3E%3Ccircle cx='30' cy='30' r='1.5'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
		opacity: 0.4;
		z-index: -1;
		pointer-events: none;
	}

	/* Consistent section styling with no visual breaks */
	section {
		position: relative;
		padding: 4rem 0;
		z-index: 1;
		background: transparent;
	}

	/* Create a continuous flow between sections with elegant dividers */
	section:not(.cta):not(.hero-section) {
		position: relative;
	}

	/* Elegant divider with gradient line */
	section:not(.cta):not(.hero-section)::before {
		content: "";
		position: absolute;
		top: 0;
		left: 15%;
		right: 15%;
		height: 1px;
		background: linear-gradient(
			90deg,
			transparent 0%,
			rgba(148, 163, 184, 0.05) 20%,
			rgba(148, 163, 184, 0.15) 50%,
			rgba(148, 163, 184, 0.05) 80%,
			transparent 100%
		);
	}

	/* Add subtle decorative element at section transitions */
	section:not(.cta):not(.hero-section)::after {
		content: "";
		position: absolute;
		top: -2px;
		left: 50%;
		transform: translateX(-50%);
		width: 60px;
		height: 4px;
		border-radius: 2px;
		background: linear-gradient(
			90deg,
			transparent,
			rgba(148, 163, 184, 0.2),
			transparent
		);
	}

	/* Add subtle depth with box-shadow instead of borders */
	.container {
		position: relative;
		z-index: 2;
	}

	/* Add subtle depth with box-shadow instead of borders */
	.container {
		position: relative;
		z-index: 2;
	}

	/* Hero Section - No separate background */
	.hero-section {
		padding: 2rem 2rem 3rem;
		margin: 0 auto;
		width: 100%;
		position: relative;
		overflow: visible;
	}
	.hero-content {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 2rem; /* Reduced gap to accommodate larger image */
		max-width: 1600px; /* Increased max-width */
		margin: 0 auto;
		width: 100%;
	}
	.hero-text {
		flex: 1 1 500px;
		min-width: 300px;
		max-width: 600px;
	}
	.hero-image-wrapper {
		flex: 1 1 650px;
		min-width: 400px;
		max-width: 850px;
		aspect-ratio: 1 / 1;
		max-height: 750px; /* Reduced from 850px */
		display: flex;
		align-items: center;
		justify-content: center;
		margin-top: -0.25rem;
		position: relative;
		z-index: 2;
	}

	.section-connector {
		height: 1px;
		margin: -1rem 0 -1rem;
	}
	.hero-image-wrapper img {
		width: 115%;
		height: 115%;
		object-fit: contain;
		animation: 
			fadeInUpAndScale 1.2s cubic-bezier(0.23, 1, 0.32, 1) forwards,
			floatAnimation 4s ease-in-out infinite 1.2s;
		filter: drop-shadow(0 10px 15px rgba(0, 0, 0, 0.05));
		margin: -7.5% 0 0 -7.5%;
		will-change: transform, opacity;
	}

	@keyframes fadeInUpAndScale {
		0% {
			opacity: 0;
			transform: translateY(20px) scale(1);
		}
		70% {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
		100% {
			opacity: 1;
			transform: translateY(0) scale(1.1);
		}
	}
	
	@keyframes floatAnimation {
		0%, 100% {
			transform: translateY(0) scale(1.1);
		}
		50% {
			transform: translateY(-15px) scale(1.1);
		}
	}

	/* Utility Classes */
	.text-center {
		text-align: center;
	}

	.max-w-md {
		max-width: 28rem;
	}

	.mx-auto {
		margin-left: auto;
		margin-right: auto;
	}

	.mt-6 {
		margin-top: 1.5rem;
	}

	.mt-4 {
		margin-top: 1rem;
	}

	.leading-tight {
		line-height: 1.1;
	}

	.text-sm {
		font-size: 0.875rem;
	}

	.font-semibold {
		font-weight: 600;
	}

	.rounded-xl {
		border-radius: 0.75rem;
	}

	.shadow-md {
		box-shadow:
			0 4px 6px -1px rgba(0, 0, 0, 0.1),
			0 2px 4px -1px rgba(0, 0, 0, 0.06);
	}

	.px-4 {
		padding-left: 1rem;
		padding-right: 1rem;
	}

	.pt-10 {
		padding-top: 2.5rem;
	}

	.hero-cta {
		display: flex;
		gap: 1rem;
		transition: all 0.3s ease;
		justify-content: center;
		flex-wrap: wrap;
	}

	.btn-primary {
		background: linear-gradient(135deg, #475569 0%, #334155 100%);
		color: white;
		padding: 0.9rem 1.5rem;
		font-size: 1rem;
		font-weight: 600;
		border-radius: 12px;
		box-shadow: 0 4px 20px rgba(71, 85, 105, 0.25);
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		text-decoration: none;
		display: inline-block;
		position: relative;
		overflow: hidden;
	}

	.btn-primary::before {
		content: "";
		position: absolute;
		top: 0;
		left: -100%;
		width: 100%;
		height: 100%;
		background: linear-gradient(
			90deg,
			transparent,
			rgba(255, 255, 255, 0.2),
			transparent
		);
		transition: left 0.5s;
	}

	.btn-primary:hover::before {
		left: 100%;
	}

	.btn-primary:hover {
		background: linear-gradient(135deg, #334155 0%, #1e293b 100%);
		transform: translateY(-2px);
		box-shadow: 0 8px 30px rgba(71, 85, 105, 0.35);
	}

	.btn-outline {
		border: 2px solid #64748b;
		color: #475569;
		padding: 0.9rem 1.5rem;
		font-size: 1rem;
		font-weight: 600;
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.8);
		backdrop-filter: blur(10px);
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		text-decoration: none;
		display: inline-block;
		position: relative;
	}

	.btn-outline:hover {
		background: rgba(71, 85, 105, 0.05);
		border-color: #475569;
		color: #334155;
		transform: translateY(-2px);
		box-shadow: 0 8px 25px rgba(100, 116, 139, 0.15);
	}

	.mobile-hide {
		display: inline;
	}

	/* Features Section - Consistent with main background */
	.features {
		padding: 5rem 0;
		position: relative;
		z-index: 2;
	}

	.section-header {
		text-align: center;
		max-width: 800px;
		margin: 0 auto 4rem;
		position: relative;
		z-index: 2;
	}

	.section-header h2 {
		color: #1e293b;
		font-size: clamp(2rem, 4vw, 2.5rem);
		margin-bottom: 1rem;
		background: linear-gradient(135deg, #1e293b 0%, #475569 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.section-header p {
		color: #64748b;
		font-size: 1.1rem;
		line-height: 1.6;
	}

	.features-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 2rem;
		position: relative;
		z-index: 2;
	}

	.feature-card {
		background: rgba(255, 255, 255, 0.9);
		backdrop-filter: blur(10px);
		padding: 2.5rem 2rem;
		border-radius: 20px;
		box-shadow: 0 10px 40px rgba(30, 41, 59, 0.08);
		border: 1px solid rgba(226, 232, 240, 0.5);
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
		text-align: center;
		position: relative;
		overflow: hidden;
	}

	.feature-card::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 4px;
		background: linear-gradient(90deg, #94a3b8, #cbd5e1, #e2e8f0);
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.feature-card:hover::before {
		opacity: 1;
	}

	.feature-card:hover {
		transform: translateY(-8px);
		box-shadow: 0 20px 60px rgba(30, 41, 59, 0.15);
		background: rgba(255, 255, 255, 0.95);
	}

	.feature-icon {
		width: 80px;
		height: 80px;
		background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
		border-radius: 20px;
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto 1.5rem;
		padding: 12px;
		transition: all 0.3s ease;
		position: relative;
	}

	.feature-card:hover .feature-icon {
		background: linear-gradient(135deg, #e2e8f0 0%, #cbd5e1 100%);
		transform: scale(1.05);
	}

	.feature-icon i {
		font-size: 1.5rem;
		color: var(--icon-color);
	}

	.feature-icon-img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		display: block;
	}

	/* Featured Products Section - Neutral Theme */
	.featured-products {
		padding: 5rem 0;
		position: relative;
		z-index: 2;
		background: linear-gradient(
			135deg,
			#f8fafc 0%,
			#ffffff 50%,
			#f1f5f9 100%
		);
	}

	/* Add subtle texture overlay */
	.featured-products::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: radial-gradient(
				circle at 20% 30%,
				rgba(148, 163, 184, 0.03) 0%,
				transparent 50%
			),
			radial-gradient(
				circle at 80% 70%,
				rgba(203, 213, 225, 0.03) 0%,
				transparent 50%
			);
		pointer-events: none;
		z-index: 1;
	}

	.featured-products .section-header {
		text-align: center;
		margin-bottom: 3rem;
		position: relative;
		z-index: 2;
	}

	.featured-products .section-header h2 {
		font-family: "Libre Baskerville", serif;
		font-size: clamp(2rem, 4vw, 2.5rem);
		font-weight: 600;
		margin-bottom: 1rem;
		position: relative;
		letter-spacing: -0.02em;
		background: linear-gradient(135deg, #1e293b 0%, #475569 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.featured-products .section-header h2::after {
		content: "";
		display: block;
		width: 80px;
		height: 3px;
		background: linear-gradient(90deg, #94a3b8, #cbd5e1, #e2e8f0);
		margin: 12px auto 0;
		border-radius: 2px;
		opacity: 0.8;
	}

	.featured-products .section-header p {
		margin-bottom: 1.5rem;
		color: #64748b;
		font-size: 1.1rem;
		line-height: 1.6;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
	}

	.products-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
		gap: 2.5rem;
		position: relative;
		z-index: 2;
		max-width: 1200px;
		margin: 0 auto;
	}

	.product-card {
		background: rgba(255, 255, 255, 0.95);
		backdrop-filter: blur(15px);
		border-radius: 24px;
		box-shadow:
			0 10px 40px rgba(30, 41, 59, 0.08),
			0 0 0 1px rgba(226, 232, 240, 0.6) inset;
		transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
		display: flex;
		flex-direction: column;
		overflow: hidden;
		position: relative;
		cursor: pointer;
		transform-style: preserve-3d;
	}

	.product-card::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 4px;
		background: linear-gradient(90deg, #94a3b8, #cbd5e1, #e2e8f0);
		opacity: 0;
		transition: opacity 0.4s ease;
		border-radius: 24px 24px 0 0;
	}

	.product-card:hover::before {
		opacity: 1;
	}

	.product-card:hover {
		box-shadow:
			0 25px 60px rgba(30, 41, 59, 0.15),
			0 0 0 2px rgba(148, 163, 184, 0.3) inset;
		transform: translateY(-12px) rotateX(2deg);
		background: rgba(255, 255, 255, 1);
	}

	.product-image {
		position: relative;
		border-radius: 20px;
		overflow: hidden;
		margin: 1.5rem 1.5rem 0;
		box-shadow:
