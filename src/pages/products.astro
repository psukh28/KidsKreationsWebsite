---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import { products } from "../data/products";
import PageHero from "../components/sections/PageHero.astro";
import ProductCategoryCard from "../components/products/ProductCategoryCard.astro";
import { getWebImagesByCategory } from "../lib/supabase";

// Pull managed images from Supabase (grouped by category slug).
// Falls back to the static `images` in products.ts when a category has none.
const dbImages = await getWebImagesByCategory("product");

const cards = products.map((product) => {
  const remote = dbImages[product.slug] ?? [];
  const hasRemote = remote.length > 0;
  const localImages = hasRemote ? [] : product.images;
  // Single hero image per card: prefer Supabase-managed, else first static image.
  const remoteHero = hasRemote ? remote[0] : null;
  const localHero = !hasRemote ? (localImages[0] ?? null) : null;
  return {
    product,
    remoteHero,
    localHero,
    galleryCount: hasRemote ? remote.length : localImages.length,
  };
});

// Curated bundles (Gift / Starter) use lifestyle flat-lay photography on a
// different background than the clean studio category shots, so we group them
// into their own section below the main collection grid.
const curatedSlugs = ["gift-sets", "starter-sets"];
const mainCards = cards.filter((c) => !curatedSlugs.includes(c.product.slug));
const curatedCards = cards.filter((c) => curatedSlugs.includes(c.product.slug));

// Preload the single hero image per main card.
const preloadImages = mainCards
  .map(({ remoteHero, localHero }) => remoteHero?.src ?? localHero?.src)
  .filter((src): src is string => Boolean(src));
---

<Layout title="Products - Kids Kreations" canonicalPath="/products">
  <!-- Preload critical images for faster navigation -->
  {preloadImages.map((src) => <link rel="preload" as="image" href={src} />)}

  <Navigation />

  <main>
    <PageHero
      title="Explore Our Infantwear Collection"
      description="Flexible MOQs, GOTS-certified materials, custom packaging, and export-ready babywear."
      backgroundClass="products-hero"
    />

    <section class="products">
      <div class="container">
        <div class="products-grid">
          {
            mainCards.map((card, i) => (
              <ProductCategoryCard {...card} eager={i < 3} />
            ))
          }
        </div>

        {curatedCards.length > 0 && (
          <div class="curated-group">
            <div class="group-header">
              <span>Curated Gift &amp; Starter Sets</span>
            </div>
            <p class="group-subtitle">
              Ready-to-gift bundles, beautifully packaged for retail and gifting.
            </p>
            <div class="products-grid">
              {curatedCards.map((card) => (
                <ProductCategoryCard {...card} eager={false} />
              ))}
            </div>
          </div>
        )}
      </div>
    </section>

    <section class="cta-section">
      <div class="container">
        <div class="cta-content">
          <h2>Interested in Our Products?</h2>
          <p>
            Contact us to discuss your specific requirements and get a custom
            quote
          </p>
          <a href="/contact" class="button button-primary">Request Quote</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* PageHero styles govern the header now */

  .products {
    padding: var(--spacing-xl) 0;
    background: var(--background);
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
    padding: 0 var(--spacing-lg);
    box-sizing: border-box;
  }

  /* Curated Gift & Starter Sets group */
  .curated-group {
    max-width: 1280px;
    margin: var(--spacing-2xl) auto 0;
    padding: 0 var(--spacing-lg);
    box-sizing: border-box;
  }

  .group-header {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  .group-header span {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--text-dark);
    white-space: nowrap;
  }

  .group-header::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--border-dark);
  }

  .group-subtitle {
    margin: 0.5rem 0 var(--spacing-lg);
    color: var(--text-light);
    font-size: 1rem;
    line-height: 1.6;
  }

  /* The curated grid sits inside .curated-group, which already provides
     max-width + padding, so reset those on the nested grid. */
  .curated-group .products-grid {
    max-width: none;
    padding: 0;
  }

  @media (max-width: 1200px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.75rem;
    }
  }

  @media (max-width: 768px) {
    .products-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
      max-width: 480px;
    }

    .curated-group .products-grid {
      max-width: 480px;
      margin: 0 auto;
    }

    .group-header span {
      font-size: 1.4rem;
    }
  }
</style>
