---
import { Image } from "astro:assets";

interface Props {
  product: { title: string; description: string; slug: string; badges: string[] };
  remoteHero: { src: string; alt: string } | null;
  localHero: ImageMetadata | null;
  galleryCount: number;
  eager?: boolean;
}

const { product, remoteHero, localHero, galleryCount, eager = false } = Astro.props;
const loading = eager ? "eager" : "lazy";
---

<a class="product-card" href={`/products/${product.slug}`}>
  <div class="product-media">
    {remoteHero ? (
      <img
        src={remoteHero.src}
        alt={remoteHero.alt || product.title}
        class="product-image"
        loading={loading}
        decoding="async"
        width={600}
        height={750}
      />
    ) : localHero ? (
      <Image
        src={localHero}
        alt={product.title}
        class="product-image"
        loading={loading}
        decoding="async"
        width={600}
        height={750}
        quality={85}
        format="webp"
      />
    ) : (
      <div class="media-placeholder">
        <i class="fas fa-camera-retro" />
        <span>Images coming soon</span>
      </div>
    )}

    {galleryCount > 1 && <span class="media-count">{galleryCount} styles</span>}

    <span class="media-cta">View collection →</span>
  </div>

  <div class="product-info">
    <h3 class="product-title">{product.title}</h3>
    <p class="product-description">{product.description}</p>
    <div class="card-badges">
      {product.badges.slice(0, 2).map((badge) => (
        <span class="chip">{badge}</span>
      ))}
    </div>
  </div>
</a>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: inherit;
    transition:
      transform var(--transition-normal),
      box-shadow var(--transition-normal),
      border-color var(--transition-normal);
  }

  .product-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-dark);
  }

  /* Media frame — uniform 4:5 regardless of source orientation */
  .product-media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--background-alt);
  }

  .product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform var(--transition-slow);
  }

  .product-card:hover .product-image {
    transform: scale(1.04);
  }

  .media-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: var(--text-lighter);
    background: var(--background-alt);
  }

  .media-placeholder i {
    font-size: 2rem;
  }

  .media-placeholder span {
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .media-count {
    position: absolute;
    top: var(--spacing-sm);
    right: var(--spacing-sm);
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(6px);
    color: var(--text-dark);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.3rem 0.6rem;
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-sm);
  }

  .media-cta {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.25rem var(--spacing-md) 0.9rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    background: linear-gradient(
      to top,
      rgba(45, 45, 45, 0.55) 0%,
      transparent 100%
    );
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity var(--transition-normal),
      transform var(--transition-normal);
  }

  .product-card:hover .media-cta {
    opacity: 1;
    transform: translateY(0);
  }

  .product-info {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: var(--spacing-md) var(--spacing-lg) var(--spacing-lg);
    flex-grow: 1;
  }

  .product-title {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text-dark);
    margin: 0;
  }

  .product-description {
    color: var(--text-light);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .chip {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--primary-dark);
    background: var(--background-alt);
    border: 1px solid var(--border);
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .media-cta {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
