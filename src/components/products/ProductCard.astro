---
import { Image } from "astro:assets";

interface Product {
  title: string;
  description: string;
  features: string[];
  images: ImageMetadata[];
  badges: string[];
  orientation: "portrait" | "landscape";
  slug: string;
}

interface Props {
  product: Product;
  productIndex: number;
}

const { product, productIndex } = Astro.props;
---

<article
  class="product-card"
  data-orientation={product.orientation}
  data-slug={product.slug}
>
  <div class="product-image-wrapper">
    {product.images && product.images.length > 0 && (
      <div class="product-gallery">
        {product.images.map((image, imageIndex) => (
          <Image
            src={image}
            alt={`${product.title} - View ${imageIndex + 1}`}
            class="product-image"
            loading={
              productIndex < 3
                ? imageIndex < 2
                  ? "eager"
                  : "lazy"
                : "lazy"
            }
            decoding="async"
            style={`display: ${imageIndex === 0 ? "block" : "none"}`}
            width={600}
            height={450}
            quality={85}
            format="webp"
          />
        ))}
        <button
          class="gallery-nav gallery-prev"
          aria-label="Previous image"
        >
          ←
        </button>
        <button
          class="gallery-nav gallery-next"
          aria-label="Next image"
        >
          →
        </button>
        <div class="gallery-dots">
          {product.images.map((_, imageIndex) => (
            <button
              class="gallery-dot"
              aria-label={`View image ${imageIndex + 1}`}
              data-index={imageIndex}
            />
          ))}
        </div>
        <button class="zoom-button" aria-label="Zoom image">
          <i class="fas fa-search-plus" />
        </button>
        <div class="loading-indicator" style="display: none;">
          <div class="spinner" />
        </div>
      </div>
    )}
  </div>
  <div class="product-info">
    <h3 class="product-title">{product.title}</h3>
    <p class="product-description">{product.description}</p>
    <ul class="product-features">
      {product.features.map((feature) => (
        <li class="feature-item">
          <i class="fas fa-check" />
          <span>{feature}</span>
        </li>
      ))}
    </ul>
    <div
      class="badge-rotator"
      id={`badge-rotator-${productIndex}`}
      data-badges={JSON.stringify(product.badges)}
    >
      <span
        class="badge badge-animated"
        id={`rotatingBadge-${productIndex}`}
      />
    </div>
  </div>
</article>

<style>
  .product-card {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(15px);
    border-radius: 24px;
    overflow: hidden;
    box-shadow:
      0 10px 40px rgba(30, 41, 59, 0.08),
      0 0 0 1px rgba(226, 232, 240, 0.6) inset;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    height: 100%;
    min-height: 420px;
    display: flex;
    flex-direction: column;
    animation: fadeIn 0.5s ease-out;
    cursor: pointer;
    position: relative;
    transform-style: preserve-3d;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .product-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #94a3b8, #cbd5e1, #e2e8f0);
    opacity: 0;
    transition: opacity 0.4s ease;
    border-radius: 24px 24px 0 0;
    z-index: 2;
  }

  .product-card:hover::before {
    opacity: 1;
  }

  .product-card:hover {
    box-shadow:
      0 25px 60px rgba(30, 41, 59, 0.15),
      0 0 0 2px rgba(148, 163, 184, 0.3) inset;
    transform: translateY(-12px) rotateX(2deg);
    background: rgba(255, 255, 255, 1);
  }

  .product-image-wrapper {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
    aspect-ratio: var(--aspect-ratio);
    margin: 1.5rem 1.5rem 0;
    border-radius: 20px;
    box-shadow:
      0 8px 25px rgba(30, 41, 59, 0.08),
      0 0 0 1px rgba(226, 232, 240, 0.4) inset;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .product-card:hover .product-image-wrapper {
    box-shadow:
      0 15px 40px rgba(30, 41, 59, 0.15),
      0 0 0 2px rgba(148, 163, 184, 0.2) inset;
    transform: translateY(-4px);
  }

  .product-card[data-orientation="portrait"] {
    --aspect-ratio: 3/4;
  }

  .product-card[data-orientation="landscape"] {
    --aspect-ratio: 4/3;
  }

  .product-gallery {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    touch-action: pan-y pinch-zoom;
    cursor: grab;
    transition: transform 0.1s ease;
  }

  .product-gallery:active {
    cursor: grabbing;
  }

  .product-gallery.swiping {
    transform: scale(0.98);
    transition: transform 0.1s ease;
  }

  .product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 20px;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    filter: saturate(0.95) brightness(1.05);
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }

  .product-card:hover .product-image {
    transform: scale(1.05);
    filter: saturate(1) brightness(1.1);
  }

  .loading-indicator {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 30;
  }

  .product-info {
    padding: 1.5rem 2rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    flex-grow: 1;
    position: relative;
  }

  .product-info::before {
    content: "";
    position: absolute;
    top: 0;
    left: 2rem;
    right: 2rem;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(148, 163, 184, 0.2) 20%,
      rgba(148, 163, 184, 0.4) 50%,
      rgba(148, 163, 184, 0.2) 80%,
      transparent 100%
    );
  }

  .product-title {
    font-family: "Libre Baskerville", serif;
    font-size: 1.375rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    line-height: 1.3;
    background: linear-gradient(135deg, #1e293b 0%, #475569 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .product-description {
    color: #64748b;
    font-size: 1rem;
    line-height: 1.6;
    margin: 0 0 0.5rem 0;
    min-height: 57px;
  }

  .product-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: #64748b;
    line-height: 1.5;
  }

  .feature-item i {
    color: #059669;
    font-size: 0.8rem;
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ecfdf5;
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: 0 2px 6px rgba(5, 150, 105, 0.15);
  }

  .zoom-button {
    position: absolute;
    top: var(--spacing-sm);
    right: var(--spacing-sm);
    background: rgba(255, 255, 255, 0.9);
    border: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    z-index: 20;
    backdrop-filter: blur(4px);
    opacity: 0;
    box-shadow: 0 4px 12px rgba(30, 41, 59, 0.15);
  }

  .product-card:hover .zoom-button {
    opacity: 1;
  }

  .zoom-button:hover {
    background: linear-gradient(135deg, #1e293b 0%, #475569 100%);
    color: white;
    transform: scale(1.1);
    box-shadow: 0 6px 20px rgba(30, 41, 59, 0.25);
  }

  .gallery-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.9);
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    cursor: pointer;
    color: var(--text-dark);
    transition: all 0.3s ease;
    z-index: 20;
    opacity: 0;
    backdrop-filter: blur(4px);
    box-shadow: 0 4px 12px rgba(30, 41, 59, 0.15);
  }

  .gallery-prev {
    left: 8px;
  }

  .gallery-next {
    right: 8px;
  }

  .product-card:hover .gallery-nav {
    opacity: 1;
  }

  .gallery-nav:hover {
    background: linear-gradient(135deg, #1e293b 0%, #475569 100%);
    color: rgb(255, 255, 255);
    transform: translateY(-50%) scale(1.1);
    box-shadow: 0 6px 20px rgba(30, 41, 59, 0.25);
  }

  .gallery-dots {
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 4px;
    z-index: 20;
    background: rgba(255, 255, 255, 0.5);
    padding: 4px 8px;
    border-radius: var(--radius-full);
    backdrop-filter: blur(4px);
  }

  .gallery-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.3);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .gallery-dot.active {
    background: linear-gradient(135deg, #1e293b 0%, #475569 100%);
    transform: scale(1.2);
    box-shadow: 0 2px 6px rgba(30, 41, 59, 0.25);
  }

  .badge-rotator {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    margin-top: 1rem;
    margin-bottom: 0.5rem;
    min-height: 32px;
    position: static;
    z-index: 3;
  }

  .badge-animated {
    display: inline-block;
    padding: 0.5rem 1.1rem;
    border-radius: 20px;
    background: rgba(30, 41, 59, 0.9);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    opacity: 1;
    transition: all 0.4s;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 90px;
    max-width: 280px;
    text-align: center;
    box-shadow:
      0 4px 12px rgba(30, 41, 59, 0.25),
      0 0 0 1px rgba(255, 255, 255, 0.1) inset;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    backdrop-filter: blur(10px);
  }

  .product-card:hover .badge-animated {
    transform: translateY(-2px);
    box-shadow:
      0 6px 20px rgba(30, 41, 59, 0.35),
      0 0 0 1px rgba(255, 255, 255, 0.15) inset;
  }

  .badge-animated.fade-out {
    opacity: 0;
  }

  @media (max-width: 768px) {
    .product-info {
      padding: 1.5rem 1.5rem 2rem;
      gap: 0.875rem;
      align-items: center;
      text-align: center;
    }

    .product-info::before {
      left: 1.5rem;
      right: 1.5rem;
    }

    .product-title {
      font-size: 1.25rem;
    }

    .product-description {
      font-size: 0.9rem;
    }

    .feature-item {
      font-size: 0.85rem;
      gap: 0.625rem;
    }

    .badge-animated {
      font-size: 0.6rem;
      padding: 0.4rem 0.9rem;
      min-width: 70px;
      max-width: 220px;
      white-space: normal;
      text-align: center;
    }

    .gallery-nav {
      display: none;
    }

    .product-gallery::after {
      content: "← Swipe →";
      position: absolute;
      bottom: 8px;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(0, 0, 0, 0.7);
      color: white;
      padding: 4px 12px;
      border-radius: 12px;
      font-size: 0.75rem;
      opacity: 0;
      transition: opacity 0.3s ease;
      pointer-events: none;
      z-index: 25;
    }

    .product-card:hover .product-gallery::after {
      opacity: 1;
    }

    .product-gallery.show-swipe-hint::after {
      opacity: 1;
    }

    .product-gallery {
      touch-action: pan-y pinch-zoom;
    }
  }

  @media (max-width: 480px) {
    .product-info {
      padding: 1rem;
      width: 100%;
      box-sizing: border-box;
    }

    .badge-rotator {
      min-height: 24px;
    }

    .badge-animated {
      font-size: 0.75rem;
      padding: 0.3rem 0.7rem;
      min-width: 60px;
      max-width: 100px;
    }

    .product-card {
      width: 100%;
      max-width: 100%;
      margin: 0 auto;
      box-sizing: border-box;
    }

    .product-image-wrapper {
      width: calc(100% - 2rem);
      margin: 1rem 1rem 0;
      box-sizing: border-box;
    }
  }
</style>