---
import logo from "../assets/icons/logo1.svg";

const menuItems = [
  { href: "/", text: "Home" },
  { href: "/about", text: "About" },
  { href: "/services", text: "Services" },
  { href: "/products", text: "Products" },
  { href: "/contact", text: "Contact" },
];

const currentPath = Astro.url.pathname;
---

<header class="header">
  <nav class="nav">
    <div class="container">
      <div class="nav-content">
        <a href="/" class="logo">
          <img
            src={(logo as any)?.src || logo}
            alt="Kids Kreations Logo"
            width={65}
            height={60}
            class="logo-img"
            loading="eager"
            fetchpriority="high"
          />
          <span class="logo-text">Kids Kreations</span>
        </a>

        <button class="mobile-menu-toggle" aria-label="Toggle menu" type="button">
          <span></span>
          <span></span>
          <span></span>
        </button>

        <div class="nav-menu">
          {
            menuItems.map((item) => (
              <a
                href={item.href}
                class={`nav-link ${item.href === currentPath ? "active" : ""}`}
              >
                {item.text}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </nav>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 80px; /* Fixed height for the header */
    z-index: 100;
    border-bottom: 3px solid rgba(148, 163, 184, 0.3);
    box-shadow: 0 20px 40px rgba(30, 41, 59, 0.08);
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
  }

  /* Add sophisticated texture effect */
  .header::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(
        circle at 25% 25%,
        rgba(148, 163, 184, 0.05) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 75% 75%,
        rgba(203, 213, 225, 0.05) 0%,
        transparent 50%
      ),
      linear-gradient(
        135deg,
        rgba(248, 250, 252, 0.8) 0%,
        rgba(241, 245, 249, 0.6) 100%
      );
    pointer-events: none;
    z-index: -1;
  }

  /* Add gradient border effect */
  .header::after {
    content: "";
    position: absolute;
    top: auto;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: linear-gradient(135deg, #f1f5f9, #e2e8f0, #cbd5e1, #94a3b8);
    z-index: 1;
    opacity: 0.6;
  }

  .nav {
    height: 100%;
    width: 100%;
    display: flex;
    align-items: center;
  }

  .container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .nav-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1rem;
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
    position: relative;
    z-index: 100;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    transition: opacity 0.3s ease;
    padding-right: 1rem;
  }

  .logo:hover {
    opacity: 0.9;
  }

  .logo-img {
    width: 65px;
    height: 60px;
    object-fit: contain;
    image-rendering: -webkit-optimize-contrast;
    image-rendering: crisp-edges;
    max-height: 60px; /* Ensure it doesn't exceed the navbar height */
  }

  .logo-text {
    font-family: "Libre Baskerville", serif;
    font-size: clamp(1.5rem, 2vw, 2.25rem);
    font-weight: 600;
    color: var(--text-dark);
    transition: all 0.3s ease;
    letter-spacing: 0.01em;
    background: linear-gradient(135deg, #1e293b 0%, #475569 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .logo:hover .logo-text {
    background: linear-gradient(135deg, #334155 0%, #64748b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    transform: translateY(-1px);
  }

  .nav-menu {
    display: flex;
    gap: 2.5rem;
    align-items: center;
    margin-left: auto;
    padding-left: 3rem;
  }

  .nav-link {
    color: var(--text-dark);
    text-decoration: none;
    font-weight: 500;
    position: relative;
    padding: 0.5rem 0;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--primary);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s ease;
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav-link.active {
    color: var(--primary);
  }

  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    gap: 6px;
    background: none;
    border: none;
    padding: 8px;
    cursor: pointer;
    z-index: 101; /* Ensure it's above the menu */
    margin-right: 5px;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-menu-toggle span {
    display: block;
    width: 24px;
    height: 3px;
    background: #1e293b;
    transition: 0.3s;
    border-radius: 2px;
    margin: 2px 0;
  }

  @media (max-width: 768px) {
    .mobile-menu-toggle {
      display: flex;
      position: relative;
      z-index: 101;
      align-items: center;
      justify-content: center;
    }
    
    /* Add animation for the hamburger menu */
    .mobile-menu-toggle.active span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    
    .mobile-menu-toggle.active span:nth-child(2) {
      opacity: 0;
    }
    
    .mobile-menu-toggle.active span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    .nav-menu {
      position: fixed;
      top: 80px; /* Match the fixed header height */
      left: 0;
      right: 0;
      background: white;
      padding: 2rem 1.5rem;
      flex-direction: column;
      gap: 1.6rem;
      transform: translateY(-100%);
      opacity: 0;
      pointer-events: none;
      transition: all 0.3s ease;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
      height: calc(100vh - 80px);
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      margin-left: 0;
      padding-left: 1.5rem;
      z-index: 99; /* Ensure it's above other content */
    }

    .nav-menu.active {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
      z-index: 99;
    }

    .nav-link {
      font-size: 1.2rem;
      font-weight: 500;
      color: #1e293b;
      text-decoration: none;
      position: relative;
      padding: 0.75rem 0 0.75rem 1.5rem;
      transition: all 0.3s ease;
      cursor: pointer;
      min-height: 48px;
      display: flex;
      align-items: center;
    }

    .nav-link::before {
      content: "";
      position: absolute;
      left: 0;
      top: 50%;
      width: 6px;
      height: 6px;
      background-color: transparent;
      border-radius: 50%;
      transform: translateY(-50%);
      transition: background-color 0.3s ease;
    }

    .nav-link:hover {
      color: var(--primary);
    }

    .nav-link:hover::before {
      background-color: var(--primary);
    }

    .nav-link.active {
      font-weight: 600;
      color: var(--primary);
    }

    .nav-link.active::before {
      background-color: var(--primary);
    }

    .nav-link:active {
      transform: scale(0.98);
      transition: transform 0.1s ease;
    }

    .logo-text {
      font-size: 1.25rem;
    }

    .logo-img {
      width: 48px;
      height: 45px;
    }
  }

  @keyframes fadeIn {
    0% {
      opacity: 0;
      transform: translateY(-12px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  // Wait for DOM to be fully loaded
  document.addEventListener("DOMContentLoaded", function() {
    // Add padding to body for fixed header
    document.body.style.paddingTop = "80px";
    
    // Get elements
    const menuToggle = document.querySelector(".mobile-menu-toggle");
    const navMenu = document.querySelector(".nav-menu");
    
    // Set up mobile menu toggle
    if (menuToggle && navMenu) {
      // Initialize aria-expanded attribute
      menuToggle.setAttribute("aria-expanded", "false");
      
      // Add click event with debugging
      menuToggle.addEventListener("click", function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        // Toggle menu visibility
        const isActive = navMenu.classList.contains("active");
        
        if (isActive) {
          navMenu.classList.remove("active");
          menuToggle.classList.remove("active");
          menuToggle.setAttribute("aria-expanded", "false");
        } else {
          navMenu.classList.add("active");
          menuToggle.classList.add("active");
          menuToggle.setAttribute("aria-expanded", "true");
        }
      });
      
      // Close menu when clicking outside
      document.addEventListener("click", function(e) {
        const target = e.target;
        if (navMenu.classList.contains("active") && 
            !navMenu.contains(target) && 
            !menuToggle.contains(target)) {
          navMenu.classList.remove("active");
          menuToggle.classList.remove("active");
          menuToggle.setAttribute("aria-expanded", "false");
        }
      });
    }
    
    // Handle active state for current page
    const currentPath = window.location.pathname;
    document.querySelectorAll(".nav-link").forEach(function(link) {
      if (link.getAttribute("href") === currentPath) {
        link.classList.add("active");
      }
    });
  });
</script>
