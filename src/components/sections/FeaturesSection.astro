---
interface Feature {
	title: string;
	description: string;
	icon: ImageMetadata | string;
	type: "image" | "fa";
	color: string;
}

interface Props {
	features: Feature[];
}

const { features } = Astro.props;

// Helper function to get SVG src
function getImageSrc(icon: ImageMetadata | string): string {
	if (typeof icon === 'string') {
		return icon;
	}
	// Handle Astro's ImageMetadata object
	if (icon && typeof icon === 'object') {
		// Check for .src property (Astro's imported SVG)
		if ('src' in icon && typeof (icon as any).src === 'string') {
			return (icon as any).src;
		}
		// Fallback: try to stringify if it's a URL object
		if ('href' in icon) {
			return (icon as any).href;
		}
	}
	return '';
}
---

<section class="features">
	<div class="container">
		<div class="section-header">
			<h2>Why Choose Us</h2>
			<p>Premium manufacturing solutions for your infantwear brand</p>
		</div>
		<div class="features-grid">
			{
				features.map((feature) => {
					const iconSrc = getImageSrc(feature.icon);
					
					return (
						<div class="feature-card" data-aos="fade-up">
							<div
								class="feature-icon"
								style={`--icon-color: ${feature.color}`}
							>
								{feature.type === "fa" ? (
									<i class={`fas ${feature.icon}`} />
								) : (
									<img
										src={iconSrc}
										alt={feature.title}
										width={64}
										height={64}
										loading="lazy"
										class="feature-icon-img"
									/>
								)}
							</div>
							<h3>{feature.title}</h3>
							<p>{feature.description}</p>
						</div>
					);
				})
			}
		</div>
	</div>
</section>