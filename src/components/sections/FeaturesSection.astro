---
interface Feature {
	title: string;
	description: string;
	icon: ImageMetadata | string;
	type: "image" | "fa";
	color: string;
}

interface Props {
	features: Feature[];
}

const { features } = Astro.props;
---

<section class="features">
	<div class="container">
		<div class="section-header">
			<h2>Why Choose Us</h2>
			<p>Premium manufacturing solutions for your infantwear brand</p>
		</div>
		<div class="features-grid">
			{
				features.map((feature) => {
					// In Astro, imported SVGs have a .src property
					const iconSrc = typeof feature.icon === 'string' 
						? feature.icon 
						: (feature.icon as any)?.src || feature.icon;
					
					return (
						<div class="feature-card" data-aos="fade-up">
							<div
								class="feature-icon"
								style={`--icon-color: ${feature.color}`}
							>
								{feature.type === "fa" ? (
									<i class={`fas ${feature.icon}`} />
								) : (
									<img
										src={iconSrc}
										alt={feature.title}
										width={64}
										height={64}
										loading="lazy"
										class="feature-icon-img"
									/>
								)}
							</div>
							<h3>{feature.title}</h3>
							<p>{feature.description}</p>
						</div>
					);
				})
			}
		</div>
	</div>
</section>