---
interface Props {
	title: string;
	description: string;
	buttonText: string;
	buttonUrl: string;
}

const { title, description, buttonText, buttonUrl } = Astro.props;
---

<section class="cta">
	<div class="container">
		<div class="cta-content">
			<h2>{title}</h2>
			<p>{description}</p>
			<a href={buttonUrl} class="button button-primary">{buttonText}</a>
		</div>
	</div>
</section>