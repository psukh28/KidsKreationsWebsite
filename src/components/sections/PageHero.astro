---
interface Props {
  title: string;
  description: string;
  backgroundClass?: string;
}

const { title, description, backgroundClass = "default-hero" } = Astro.props;
---

<section class={`hero ${backgroundClass}`}>
  <div class="container">
    <div class="section-title">
      <h1 class="page-title">{title}</h1>
      <p class="page-desc">{description}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 3rem 0 0.5rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    color: var(--text-dark);
    margin-bottom: 0.5rem;
  }

  .page-desc {
    color: var(--text-light);
    font-size: 1rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .default-hero {
    background: linear-gradient(135deg, var(--background-alt) 0%, var(--background) 50%, var(--background-dark) 100%);
  }

  .hero::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23D6CFC7' fill-opacity='0.2'%3E%3Ccircle cx='30' cy='30' r='1.5'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    opacity: 0.8;
    z-index: 1;
    pointer-events: none;
  }

  .container {
    position: relative;
    z-index: 2;
  }

  /* Alternative hero backgrounds */
  .about-hero {
    background: linear-gradient(135deg, var(--background-alt) 0%, var(--background) 50%, var(--background-dark) 100%);
  }

  .services-hero {
    background: linear-gradient(to right, var(--background-alt), var(--background));
  }

  .contact-hero {
    background: linear-gradient(to right, var(--background-alt), var(--background));
  }

  .products-hero {
    background: linear-gradient(135deg, var(--background-alt) 0%, var(--background) 50%, var(--background-dark) 100%);
  }

  .products-hero::before {
    background: radial-gradient(
        circle at 25% 25%,
        rgba(138, 126, 113, 0.05) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 75% 75%,
        rgba(214, 207, 199, 0.05) 0%,
        transparent 50%
      );
  }
</style>