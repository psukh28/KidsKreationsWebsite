---
import { Image } from "astro:assets";
import featureImg1 from "../../assets/lookbook/winter_2.png";
import featureImg2 from "../../assets/lookbook/sleepsuit_1.png";
import featureImg3 from "../../assets/lookbook/dress_1.png";
---

<section class="lookbook-editorial section">
  <div class="container editorial-layout" data-aos="fade-up">
    <!-- Text side -->
    <div class="editorial-copy">
      <span class="eyebrow">The Studio Edit</span>
      <h2>Discover the<br />Collection</h2>
      <p class="editorial-text">
        A curated visual journal of our manufacturing capabilities — pristine
        garments, exquisite fabrics, and timeless design.
      </p>
      <a href="/lookbook" class="editorial-link">
        Enter the Lookbook
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14M12 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>

    <!-- Image side -->
    <div class="editorial-gallery">
      <a
        href="/lookbook"
        class="editorial-img-wrapper"
        aria-label="View Winter Collection in Lookbook"
      >
        <span class="gallery-cap"><span>Lookbook · Winter</span><span class="gallery-num">01</span></span>
        <Image
          src={featureImg1}
          alt="Studio Winter Piece"
          class="gallery-image"
          width={280}
          quality={85}
          format="webp"
        />
      </a>
      <a
        href="/lookbook"
        class="editorial-img-wrapper"
        aria-label="View Sleepsuit Collection in Lookbook"
      >
        <span class="gallery-cap"><span>Lookbook · Sleepwear</span><span class="gallery-num">02</span></span>
        <Image
          src={featureImg2}
          alt="Studio Sleepsuit Piece"
          class="gallery-image"
          width={280}
          quality={85}
          format="webp"
        />
      </a>
      <a
        href="/lookbook"
        class="editorial-img-wrapper"
        aria-label="View Dress Collection in Lookbook"
      >
        <span class="gallery-cap"><span>Lookbook · Occasion</span><span class="gallery-num">03</span></span>
        <Image
          src={featureImg3}
          alt="Studio Dress Piece"
          class="gallery-image"
          width={280}
          quality={85}
          format="webp"
        />
      </a>
    </div>
  </div>
</section>

<style>
  /* Editorial section — matches homepage hero vibe (handoff palette/type) */
  .lookbook-editorial {
    --kk-ink: #463f33;
    --kk-muted: #8c8475;
    --kk-gold: #a89468;
    --kk-gold-line: #c7b891;
    --kk-caption: #6e5f45;
    --kk-cream: #f4f1e9;
    --kk-serif: "Spectral", Georgia, serif;
    --kk-sans: "Mulish", system-ui, sans-serif;
    --kk-mono: "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;

    background:
      radial-gradient(120% 90% at 88% 30%, #faf7f0 0%, var(--kk-cream) 55%);
    padding: 4rem 0;
    position: relative;
    overflow: hidden;
  }

  /* Side-by-side editorial layout */
  .editorial-layout {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 3rem;
    align-items: center;
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Copy block */
  .editorial-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .eyebrow {
    display: inline-block;
    font-family: var(--kk-mono);
    font-size: 0.66rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: var(--kk-gold);
    margin-bottom: 1rem;
  }

  h2 {
    font-family: var(--kk-serif);
    font-size: clamp(2rem, 4vw, 2.85rem);
    font-weight: 600;
    line-height: 1.04;
    margin-bottom: 1.1rem;
    color: var(--kk-ink);
    letter-spacing: -0.5px;
  }

  .editorial-text {
    font-size: 1.05rem;
    color: var(--kk-muted);
    margin-bottom: 1.75rem;
    line-height: 1.55;
    font-family: var(--kk-sans);
    max-width: 360px;
  }

  .editorial-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--kk-mono);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--kk-ink);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    border-bottom: 1.5px solid var(--kk-gold-line);
    padding-bottom: 5px;
    transition: color 0.4s, border-color 0.4s, gap 0.4s;
  }

  .editorial-link:hover {
    color: var(--kk-gold);
    border-color: var(--kk-gold);
    gap: 0.75rem;
  }

  .editorial-link svg {
    transition: transform 0.4s ease;
  }

  .editorial-link:hover svg {
    transform: translateX(3px);
  }

  /* Triptych Gallery */
  .editorial-gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .editorial-img-wrapper {
    position: relative;
    width: 100%;
    min-width: 0;
    display: block;
    overflow: hidden;
    background: #fbf9f3;
    border-radius: 6px;
    border: 1px solid rgba(120, 100, 70, 0.16);
    box-shadow: 0 18px 40px -30px rgba(70, 55, 35, 0.45);
    transition: box-shadow 0.5s ease, transform 0.5s ease;
  }

  .editorial-img-wrapper:hover {
    box-shadow: 0 22px 46px -28px rgba(70, 55, 35, 0.55);
    transform: translateY(-2px);
  }

  /* monospace caption overlay — echoes the hero image grid */
  .gallery-cap {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 11px 12px;
    font-family: var(--kk-mono);
    font-size: 9.5px;
    letter-spacing: 0.6px;
    line-height: 1.35;
    text-transform: uppercase;
    color: var(--kk-caption);
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(251, 249, 243, 0.92) 0%,
      rgba(251, 249, 243, 0) 100%
    );
  }
  .gallery-num {
    color: var(--kk-gold);
    font-weight: 500;
  }

  .gallery-image {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center;
    display: block;
    transform: scale(1.01);
    transition: transform 1.2s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.8s ease;
    opacity: 0.95;
  }

  .editorial-img-wrapper:hover .gallery-image {
    transform: scale(1.08);
    opacity: 1;
  }

  /* Responsive Design */
  @media (max-width: 992px) {
    .lookbook-editorial {
      padding: 3rem 0;
    }

    .editorial-layout {
      gap: 2rem;
    }

    h2 {
      font-size: 1.75rem;
    }
  }

  @media (max-width: 768px) {
    .editorial-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      text-align: center;
    }

    .editorial-copy {
      align-items: center;
    }

    h2 {
      font-size: 1.75rem;
    }

    h2 br {
      display: none;
    }

    .editorial-gallery {
      gap: 0.5rem;
    }

    .eyebrow {
      letter-spacing: 0.15em;
    }
  }

  @media (max-width: 480px) {
    .lookbook-editorial {
      padding: 2.5rem 0;
    }

    .editorial-layout {
      padding: 0 1rem;
    }

    .editorial-gallery {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 0 1rem;
    }
  }
</style>
