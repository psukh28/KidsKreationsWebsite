---
import { Image } from 'astro:assets';
import PerformanceOptimizer from '../components/PerformanceOptimizer.astro';
import PerformanceMonitor from '../components/PerformanceMonitor.astro';
import Analytics from '@vercel/analytics/astro';
import '../styles/base/variables.css';
import '../styles/base/typography.css';


interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
}

const { title, description = "Premium infantwear OEM/ODM manufacturer in Thailand. 23+ years experience, GOTS certified, ethical production. Partner with 30+ global brands.", canonicalPath = '' } = Astro.props;
const canonicalUrl = `https://kidskreationsco.com${canonicalPath}`;

const fontLinks = [
  'https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;500;600;700&display=swap',
  'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap',
  // Hero (editorial redesign) typeface set — scoped to the homepage hero
  'https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,400;0,500;0,600;0,700&family=Cormorant+Garamond:ital,wght@1,600&family=Mulish:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap'
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    
    <!-- Critical CSS inline to prevent FOUC -->
    <style>
      html{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Oxygen,Ubuntu,Cantarell,sans-serif;background:#f8f9fa}body{margin:0;padding:0;overflow-x:hidden}*{box-sizing:border-box}
      /* Prevent layout shift during font load */
      h1,h2,h3,h4,h5,h6{font-family:-apple-system,BlinkMacSystemFont,sans-serif;font-weight:600;line-height:1.3}
      .hero-section,.nav,.footer{visibility:visible!important}
    </style>
    
    <title>{title ?? 'Kids Kreations Company Limited – Trusted Babywear Manufacturer Since 2000'}</title>
    <meta name="description" content={description ?? 'Manufacturer of premium baby gift sets and infant garments based in Thailand. Trusted OEM & ODM supplier for brands worldwide since 2000.'} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph (Facebook, LinkedIn, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://kidskreationsco.com/" />
    <meta property="og:title" content="Kids Kreations Company Limited – Trusted Babywear Manufacturer Since 2000" />
    <meta property="og:description" content="OEM/ODM baby garments and gift sets crafted in Thailand. Supplying brands across North America, Europe, and the Middle East." />
    <meta property="og:image" content="https://kidskreationsco.com/images/og-image.png" />
    <meta property="og:site_name" content="Kids Kreations Co." />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Kids Kreations Company Limited – Trusted Babywear Manufacturer Since 2000" />
    <meta name="twitter:description" content="Explore our wide range of infant apparel and curated gift sets, designed and manufactured in Thailand." />
    <meta name="twitter:image" content="https://kidskreationsco.com/images/og-image.png" />

    <!-- Performance Optimizations -->
    <PerformanceOptimizer 
      dnsPrefetch={["//fonts.googleapis.com", "//fonts.gstatic.com", "//cdnjs.cloudflare.com"]}
      preconnect={["https://fonts.googleapis.com", "https://fonts.gstatic.com", "https://cdnjs.cloudflare.com"]}
    />
    
    <!-- Google Fonts - Load synchronously to prevent FOUC -->
    {fontLinks.map(link => (
      <link rel="stylesheet" href={link} />
    ))}

    <!-- FontAwesome Icons - Load synchronously to prevent FOUC -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Performance Monitoring -->
    <PerformanceMonitor />

    <!-- Technical and Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Organization Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Kids Kreations Company Limited",
      "url": "https://kidskreationsco.com/",
      "logo": "https://kidskreationsco.com/images/logokkpng.png",
      "sameAs": [
        "https://www.facebook.com/kidskreationsth",
        "https://www.instagram.com/kidskreations/"
      ],
      "description": "OEM/ODM babywear manufacturer based in Thailand since 2000. Specializing in infant gift sets and apparel."
    }
    </script>

    <!-- Service Worker Registration -->
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js')
            .then((registration) => {
              console.log('SW registered: ', registration);
            })
            .catch((registrationError) => {
              console.log('SW registration failed: ', registrationError);
            });
        });
      }
    </script>
  <Analytics />
  </head>
  <body>
    <slot />
    <script>
    /**
     * Cookie Consent Banner
     * - Shows only on first visit (checks for 'cookieConsent' cookie)
     * - Sets cookieConsent=accepted or declined for 180 days
     * - Auto-hides after 15 seconds if no action
     * - Slide-up animation, modern dark style
     */
    (function() {
      // Helper: Get cookie by name
      function getCookie(name: any) {
        return document.cookie.split('; ').find(row => row.startsWith(name + '='))?.split('=')[1];
      }

      // Helper: Set cookie with expiration in days
      function setCookie(name: any, value: any, days: any) {
        const expires = new Date(Date.now() + days*24*60*60*1000).toUTCString();
        document.cookie = `${name}=${value}; expires=${expires}; path=/; SameSite=Lax`;
      }

      // Only show if cookieConsent not set
      if (getCookie('cookieConsent')) return;

      // Create banner
      const banner = document.createElement('div');
      banner.id = 'cookie-consent-banner';
      banner.innerHTML = `
        <div class="cookie-content">
          <span>We use cookies to enhance your browsing experience and understand how our site is used. You can manage your preferences below.</span>
          <div class="cookie-actions">
            <button id="cookie-accept">Accept</button>
            <button id="cookie-decline">Decline</button>
          </div>
        </div>
      `;
      document.body.appendChild(banner);

      // Slide-up animation
      setTimeout(() => banner.classList.add('cookie-visible'), 100);

      // Handle Accept/Decline
      function handleChoice(choice: any) {
        setCookie('cookieConsent', choice, 180);
        banner.classList.remove('cookie-visible');
        setTimeout(() => banner.remove(), 500);
      }
      const acceptBtn = document.getElementById('cookie-accept');
      const declineBtn = document.getElementById('cookie-decline');
      if (acceptBtn) acceptBtn.onclick = () => handleChoice('accepted');
      if (declineBtn) declineBtn.onclick = () => handleChoice('declined');

      // Auto-hide after 15s
      setTimeout(() => {
        if (!getCookie('cookieConsent')) {
          handleChoice('auto-hide');
        }
      }, 15000);

      // Styles
      const style = document.createElement('style');
      style.textContent = `
        #cookie-consent-banner {
          position: fixed;
          left: 0; right: 0; bottom: 0;
          z-index: 9999;
          display: flex;
          justify-content: center;
          pointer-events: none;
        }
        #cookie-consent-banner .cookie-content {
          background: #222c36;
          color: #fff;
          border-radius: 1rem;
          box-shadow: 0 4px 24px rgba(0,0,0,0.18);
          padding: 1.2rem 2rem;
          margin: 1.5rem;
          display: flex;
          align-items: center;
          gap: 2rem;
          font-family: 'Inter', sans-serif;
          font-size: 1rem;
          opacity: 0;
          transform: translateY(100%);
          transition: opacity 0.4s cubic-bezier(.4,0,.2,1), transform 0.5s cubic-bezier(.4,0,.2,1);
          pointer-events: auto;
        }
        #cookie-consent-banner.cookie-visible .cookie-content {
          opacity: 1;
          transform: translateY(0);
        }
        .cookie-actions {
          display: flex;
          gap: 0.75rem;
        }
        .cookie-actions button {
          background: #fff;
          color: #222c36;
          border: none;
          border-radius: 0.5rem;
          padding: 0.5rem 1.2rem;
          font-size: 1rem;
          font-weight: 600;
          cursor: pointer;
          transition: background 0.2s, color 0.2s, box-shadow 0.2s;
          box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }
        .cookie-actions button:hover {
          background: #8A7E71;
          color: #fff;
        }
        @media (max-width: 600px) {
          #cookie-consent-banner .cookie-content {
            flex-direction: column;
            gap: 1rem;
            padding: 1rem;
          }
        }
      `;
      document.head.appendChild(style);
    })();
    </script>
  </body>
</html>

<style is:global>
  /* Global variables are now managed in src/styles/base/variables.css */
  
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    background: var(--background);
    color: var(--text-dark);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: clip;
    width: 100%;
  }

  body {
    margin: 0;
    padding: 0;
    overflow-x: clip;
    width: 100%;
    max-width: 100vw;
    position: relative;
  }

  h1, h2, h3, h4, h5, h6 {
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: var(--spacing-md);
    color: var(--text-dark);
  }

  h1 {
    font-size: 2.5rem;
    letter-spacing: -0.025em;
  }

  h2 {
    font-size: 2rem;
    letter-spacing: -0.025em;
  }

  h3 {
    font-size: 1.5rem;
  }

  p {
    margin-bottom: var(--spacing-md);
    color: var(--text-light);
  }

  a {
    color: var(--primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  a:hover {
    color: var(--primary-dark);
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .section {
    padding: var(--spacing-xl) 0;
  }

  .section-title {
    text-align: center;
    margin-bottom: var(--spacing-xl);
  }

  .section-title h2 {
    font-size: 2.5rem;
    color: var(--text-dark);
    margin-bottom: var(--spacing-sm);
  }

  .section-title p {
    color: var(--text-light);
    max-width: 600px;
    margin: 0 auto;
  }

  /* Card Styles */
  .card {
    background: var(--background);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: var(--spacing-lg);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  /* Button Styles */
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-md);
    font-weight: 500;
    transition: all 0.2s ease;
    cursor: pointer;
    border: none;
  }

  .button-primary {
    background: var(--primary);
    color: white;
  }

  .button-primary:hover {
    background: var(--primary-dark);
    color: white;
  }

  .button-secondary {
    background: var(--background-alt);
    color: var(--text-dark);
  }

  .button-secondary:hover {
    background: var(--background-dark);
  }

  @media (max-width: 768px) {
    .section {
      padding: var(--spacing-lg) 0;
    }

    .section-title h2 {
      font-size: 2rem;
    }

    h1 {
      font-size: 2rem;
    }

    .container {
      padding: 0 var(--spacing-sm);
    }
  }
</style> 
